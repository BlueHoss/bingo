# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database Configuration for Prisma
# DATABASE_URL uses connection pooling (port 6543) for better performance
# DIRECT_URL bypasses pooling (port 5432) and is required for migrations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# You can find these values in your Supabase project settings:
# 1. Go to your Supabase project dashboard
# 2. Click on "Settings" in the sidebar
# 3. Go to "API" section for PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY
# 4. Go to "Database" section for DATABASE_URL (use the connection string under "Connection string")

# Optional: If you want to use Supabase Edge Functions or other features
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Service (Resend) - for sending game invitations
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email From Address - Configure based on your verified domain
# For development/testing: Use Resend's test domain
RESEND_FROM_EMAIL=Cruise Bingo <onboarding@resend.dev>
# For production: Use your verified domain
# RESEND_FROM_EMAIL=Cruise Bingo <noreply@yourdomain.com> 